# ── core ────────────────────────────────────────
DATABASE_URL="postgresql://atryn:atryn@localhost:5432/atryn?schema=public"
REDIS_URL="redis://localhost:6379"
APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── auth ────────────────────────────────────────
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_TRUST_HOST="true"
# Magic-link login; local development logs links instead of sending email.
# Disable the bypass and configure Resend credentials outside local development.
MAGIC_LINK_DEV_BYPASS="true"

# ── messaging kill switches (NEVER send for real in dev) ──
OUTBOUND_MESSAGING_ENABLED="false"
SMS_PROVIDER="twilio"          # twilio | mock
EMAIL_PROVIDER="resend"        # resend | mailpit | mock

# ── email (Resend) ─────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Atryn <onboarding@atryn.com>"

# ── SMS (Twilio) ───────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
TWILIO_WEBHOOK_SECRET=""       # request signature validation

# ── payments (Stripe) ──────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_PRO=""

# ── ops ─────────────────────────────────────────
LOG_LEVEL="info"
IP_HASH_PEPPER=""              # rotating pepper for IP hashing
